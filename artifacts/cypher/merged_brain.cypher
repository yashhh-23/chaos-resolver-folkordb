MERGE (n:ExternalAPI {id: 'ext:api:stripe'}) ON CREATE SET n = {id: 'ext:api:stripe', name: 'Stripe_Gateway', category: 'Payment Processing', provider: 'Stripe, Inc.', company_origin: 'External'} ON MATCH SET n = {id: 'ext:api:stripe', name: 'Stripe_Gateway', category: 'Payment Processing', provider: 'Stripe, Inc.', company_origin: 'External'};
MERGE (n:ExternalAPI {id: 'ext:api:aws_kms'}) ON CREATE SET n = {id: 'ext:api:aws_kms', name: 'AWS_KMS', category: 'Key Management', provider: 'Amazon Web Services', company_origin: 'External'} ON MATCH SET n = {id: 'ext:api:aws_kms', name: 'AWS_KMS', category: 'Key Management', provider: 'Amazon Web Services', company_origin: 'External'};
MATCH (a {id: 'finpay:sys:customer_kyc'}), (b {id: 'ext:api:uidai_aadhaar'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'vaultly:sys:user_onboarding'}), (b {id: 'ext:api:uidai_aadhaar'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'finpay:sys:finpay_core_ledger'}), (b {id: 'ext:api:stripe'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'vaultly:sys:vault_engine'}), (b {id: 'ext:api:stripe'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'finpay:sys:gatekeeper_auth'}), (b {id: 'ext:api:aws_kms'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'vaultly:sys:pulse_identity'}), (b {id: 'ext:api:aws_kms'}) MERGE (a)-[r:CALLS]->(b);
MATCH (a {id: 'finpay:sys:gatekeeper_auth'}), (b {id: 'vaultly:sys:pulse_identity'}) MERGE (a)-[r:REDUNDANT_WITH]->(b) ON CREATE SET r.similarity = 0.93, r.reason = 'Both handle OAuth2, session token issuance, and user credential validation' ON MATCH SET r.similarity = 0.93, r.reason = 'Both handle OAuth2, session token issuance, and user credential validation';
MATCH (a {id: 'finpay:sys:finpay_core_ledger'}), (b {id: 'vaultly:sys:vault_engine'}) MERGE (a)-[r:REDUNDANT_WITH]->(b) ON CREATE SET r.similarity = 0.88, r.reason = 'Both are double-entry settlement engines interfacing with Stripe payment rails' ON MATCH SET r.similarity = 0.88, r.reason = 'Both are double-entry settlement engines interfacing with Stripe payment rails';
MATCH (a {id: 'finpay:sys:customer_kyc'}), (b {id: 'vaultly:sys:user_onboarding'}) MERGE (a)-[r:REDUNDANT_WITH]->(b) ON CREATE SET r.similarity = 0.95, r.reason = 'Both perform customer onboarding verification via UIDAI Aadhaar external API' ON MATCH SET r.similarity = 0.95, r.reason = 'Both perform customer onboarding verification via UIDAI Aadhaar external API';
MATCH (a {id: 'finpay:dec:jwt_15m'}), (b {id: 'vaultly:dec:session_7d'}) MERGE (a)-[r:CONFLICTS_WITH]->(b) ON CREATE SET r.severity = 'CRITICAL', r.domain = 'Session Security', r.reason = 'FinPay mandates 15-minute JWT expiration vs Vaultly\'s 7-day persistent mobile session tokens' ON MATCH SET r.severity = 'CRITICAL', r.domain = 'Session Security', r.reason = 'FinPay mandates 15-minute JWT expiration vs Vaultly\'s 7-day persistent mobile session tokens';
MATCH (a {id: 'finpay:dec:log_purge_30d'}), (b {id: 'vaultly:dec:log_retention_180d'}) MERGE (a)-[r:CONFLICTS_WITH]->(b) ON CREATE SET r.severity = 'HIGH', r.domain = 'Data Retention', r.reason = 'FinPay enforces 30-day log purge while Vaultly partner contract mandates 180-day forensic audit retention' ON MATCH SET r.severity = 'HIGH', r.domain = 'Data Retention', r.reason = 'FinPay enforces 30-day log purge while Vaultly partner contract mandates 180-day forensic audit retention';
MATCH (a {id: 'finpay:dec:mtls_enforcement'}), (b {id: 'vaultly:dec:api_key_bearer'}) MERGE (a)-[r:CONFLICTS_WITH]->(b) ON CREATE SET r.severity = 'MEDIUM', r.domain = 'Network Security', r.reason = 'Zero-trust SPIFFE mTLS mesh vs static API Bearer token architecture' ON MATCH SET r.severity = 'MEDIUM', r.domain = 'Network Security', r.reason = 'Zero-trust SPIFFE mTLS mesh vs static API Bearer token architecture';
MATCH (a {id: 'finpay:pol:session_security'}), (b {id: 'vaultly:pol:session_continuity'}) MERGE (a)-[r:CONFLICTS_WITH]->(b) ON CREATE SET r.severity = 'CRITICAL', r.domain = 'Authentication', r.reason = 'Direct policy contradiction between PCI-DSS strict token revocation and frictionless 7-day mobile UX' ON MATCH SET r.severity = 'CRITICAL', r.domain = 'Authentication', r.reason = 'Direct policy contradiction between PCI-DSS strict token revocation and frictionless 7-day mobile UX';
MATCH (a {id: 'finpay:pol:retention_compliance'}), (b {id: 'vaultly:pol:forensic_audit_retention'}) MERGE (a)-[r:CONFLICTS_WITH]->(b) ON CREATE SET r.severity = 'HIGH', r.domain = 'Data Retention', r.reason = 'Data minimization policy conflicts with banking audit trail retention requirement' ON MATCH SET r.severity = 'HIGH', r.domain = 'Data Retention', r.reason = 'Data minimization policy conflicts with banking audit trail retention requirement';
