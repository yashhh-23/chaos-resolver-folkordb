MERGE (n:Document {id: 'vaultly:doc:rfc_ux_042'}) ON CREATE SET n = {id: 'vaultly:doc:rfc_ux_042', company_origin: 'Vaultly', title: 'RFC-042: Frictionless 7-Day Mobile Session Persistence', doc_type: 'RFC', url: 'https://notion.vaultly.internal/rfc-42', excerpt: 'Permits 7-day persistent refresh tokens on verified mobile devices to eliminate aggressive re-authentication churn.', author_id: 'vaultly:person:diya_nair'} ON MATCH SET n = {id: 'vaultly:doc:rfc_ux_042', company_origin: 'Vaultly', title: 'RFC-042: Frictionless 7-Day Mobile Session Persistence', doc_type: 'RFC', url: 'https://notion.vaultly.internal/rfc-42', excerpt: 'Permits 7-day persistent refresh tokens on verified mobile devices to eliminate aggressive re-authentication churn.', author_id: 'vaultly:person:diya_nair'};
MERGE (n:Document {id: 'vaultly:doc:compliance_audit_2026'}) ON CREATE SET n = {id: 'vaultly:doc:compliance_audit_2026', company_origin: 'Vaultly', title: 'Neobank Forensic Audit Standard: 180-Day Retention Addendum', doc_type: 'Audit Guidelines', url: 'https://notion.vaultly.internal/audit-2026', excerpt: 'Mandates all transactional audit logs, authentication timestamps, and ledger writes be retained for minimum 180 days.', author_id: 'vaultly:person:tanya_sen'} ON MATCH SET n = {id: 'vaultly:doc:compliance_audit_2026', company_origin: 'Vaultly', title: 'Neobank Forensic Audit Standard: 180-Day Retention Addendum', doc_type: 'Audit Guidelines', url: 'https://notion.vaultly.internal/audit-2026', excerpt: 'Mandates all transactional audit logs, authentication timestamps, and ledger writes be retained for minimum 180 days.', author_id: 'vaultly:person:tanya_sen'};
