# FalkorDB Connection Settings
# For local Docker:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Alternatively, FalkorDB Cloud full connection URI:
# FALKORDB_URL=falkor://username:password@your-instance.falkordb.cloud:port

# Graph Names for Multigraph Tenancy
GRAPH_FINPAY=finpay_graph
GRAPH_VAULTLY=vaultly_graph
GRAPH_MERGED=merged_brain

# LLM Providers (for Phase 2 & 3: Agent & Embeddings)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# App Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
